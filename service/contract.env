# Shared contract between the containers, the edge proxy, the scripts and the
# systemd units.
#
# Every value that more than one file needs lives here, so the copies cannot
# drift apart.  `scripts/check-contract.py` asserts that they have not, and
# `scripts/preflight.sh` runs that check before the stack is started.
#
# This file is committed and holds no secrets.  Deployment secrets live in
# .env, which is layered on top of it.

# -- Ports ---------------------------------------------------------------
# The port uvicorn listens on inside the api container.
MD_API_PORT=8000
# The port nginx listens on inside the web container.
MD_WEB_PORT=80
# The port Caddy listens on.  This is the only port published to the host,
# and it is bound to the loopback interface.
MD_EDGE_PORT=8080

# -- Service account -----------------------------------------------------
# Every container that writes into the shared data volume runs as this
# account, so their files stay mutually readable and a plain backup can
# read the whole tree.
MD_SERVICE_UID=10001
MD_SERVICE_GID=10001

# -- Container paths -----------------------------------------------------
MD_DATA_MOUNT=/data
MD_DB_MOUNT=/db

# -- Route prefixes ------------------------------------------------------
# These must match the FastAPI router prefixes in app/main.py.  The edge
# proxy uses the internal prefix to decide which routes to refuse.
MD_API_PREFIX=/api/v1
MD_INTERNAL_PREFIX=/internal/v1
