# Service environment (copy to service/.env or export directly).
#
# Generate two different high-entropy values, for example:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
#
# Never commit the filled-in service/.env file.  Compose refuses to start while
# either value is empty, and the API returns 503 instead of serving
# authenticated endpoints.
SERVICE_API_TOKEN=
WORKER_TOKEN=

# Container paths from docs/service-implementation-plan.md.
DATABASE_URL=sqlite:////db/app.db
DATA_ROOT=/data

# CUDA in production; CPU for local smoke tests.
SIMULATION_PLATFORM=CUDA

# Enabled for v1; set false when the API must not access the internet.
ALLOW_PDB_DOWNLOAD=true

# Comma-separated frontend origins, for example https://md.example.com
CORS_ORIGINS=

# Public hostname served by Caddy (defaults to localhost).
MD_SERVICE_DOMAIN=localhost

# Disable FastAPI /docs and /openapi.json in production if desired.
DOCS_ENABLED=true

# Structured JSON request logs and public per-owner rate limiting.
# Set RATE_LIMIT_REQUESTS_PER_MINUTE=0 to disable the limiter.
LOG_LEVEL=INFO
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# Worker identity and GPU selection.
WORKER_ID=gpu-0
API_URL=http://api:8000
CUDA_VISIBLE_DEVICES=0

# Worker loop defaults (optional).
WORKER_HOSTNAME=
WORKER_GPU_NAME=
WORKER_GPU_UUID=
SIMULATE_PATH=/app/simulate.py
SIMULATE_CWD=/app
WORKER_POLL_SECONDS=2
WORKER_HEARTBEAT_SECONDS=10
WORKER_PROGRESS_POLL_SECONDS=2
WORKER_PROGRESS_SEND_SECONDS=30
WORKER_CANCEL_GRACE_SECONDS=30
WORKER_CANCEL_TERM_SECONDS=10
WORKER_REQUEST_TIMEOUT_SECONDS=30
WORKER_MAX_ARTIFACTS=2000

# Lease lifecycle (defaults shown).  The API reaps expired leases in a
# background thread.
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
REAPER_INTERVAL_SECONDS=10

# Admission and operations (defaults shown).
MAX_QUEUED_JOBS_PER_OWNER=5
MIN_FREE_DISK_BYTES=536870912
RETENTION_DAYS=0
ORPHAN_WORKSPACE_HOURS=24

# Server-sent events and log tailing.
EVENT_STREAM_POLL_SECONDS=1
EVENT_STREAM_HEARTBEAT_SECONDS=15
LOG_TAIL_MAX_BYTES=262144
LOG_TAIL_DEFAULT_LINES=200

# Host bind-mount roots used by Compose (Phase 6).
HOST_DB_DIR=/srv/md-service/db
HOST_DATA_DIR=/srv/md-service/data
