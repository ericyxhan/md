# Service environment (copy to service/.env or export directly).
#
# Generate two different high-entropy values, for example:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
#
# Never commit the filled-in service/.env file.  Compose refuses to start while
# either value is empty, and the API returns 503 instead of serving
# authenticated endpoints.
SERVICE_API_TOKEN=
WORKER_TOKEN=

# Accounts.
#
# Anyone can create an account with an email address, a first name, a last
# name, and a password.  Set REGISTRATION_ENABLED=false to keep the
# deployment invitation-only; accounts are then created by an administrator.
# Set REQUIRE_ADMIN_APPROVAL=true to hold new accounts until an
# administrator approves them.
REGISTRATION_ENABLED=true
REQUIRE_ADMIN_APPROVAL=false

# The administrator account.  It is the account the lab used before
# accounts existed, so the data that is already in the deployment moves to
# it.  The password is the lab password below.
ADMIN_EMAIL=admin@lattice.local
ADMIN_FIRST_NAME=Lab
ADMIN_LAST_NAME=Administrator
# ADMIN_PASSWORD_HASH wins; when it is empty WEB_PASSWORD_HASH is used
# instead.  Generate a hash from service/api:
#   python -c "from app.passwords import hash_password; print(hash_password('...'))"
ADMIN_PASSWORD_HASH=

# Browser login.  Browsers never receive SERVICE_API_TOKEN; they exchange
# an account email address and password for a signed, HttpOnly session
# cookie.  WEB_PASSWORD_HASH is the administrator's password when
# ADMIN_PASSWORD_HASH is empty.
#
# WEB_SESSION_SECRET signs session cookies.  Use a different high-entropy
# value from SERVICE_API_TOKEN; when empty it falls back to SERVICE_API_TOKEN,
# so rotating that token also signs every session out.
WEB_PASSWORD=
WEB_PASSWORD_HASH=
WEB_SESSION_SECRET=
WEB_SESSION_TTL_SECONDS=43200
# Keep true in production (HTTPS).  Set false only for local HTTP development.
WEB_COOKIE_SECURE=true
# Set false to keep the deployment bearer-token only: browsers cannot sign in.
WEB_LOGIN_ENABLED=true
WEB_LOGIN_ATTEMPTS_PER_MINUTE=10

# Container paths from docs/service-implementation-plan.md.
DATABASE_URL=sqlite:////db/app.db
DATA_ROOT=/data

# CUDA in production; CPU for local smoke tests.
SIMULATION_PLATFORM=CUDA

# Enabled for v1; set false when the API must not access the internet.
ALLOW_PDB_DOWNLOAD=true

# Comma-separated frontend origins, for example https://md.example.com
# Leave empty when the SPA is served from the same origin as the API.
CORS_ORIGINS=

# Public hostname served by Caddy (defaults to localhost).
# Only used by the legacy auto-HTTPS setup; the Tailscale Funnel deployment
# terminates TLS in front of Caddy and does not need this value.
MD_SERVICE_DOMAIN=localhost

# Trust the X-Forwarded-For header that Caddy rewrites to the client address
# it resolved.  Keep this enabled when the API runs behind a reverse proxy;
# disable it when running the API directly.
TRUST_FORWARDED_FOR=true

# Disable FastAPI /docs and /openapi.json in production if desired.
DOCS_ENABLED=true

# Where backup.sh writes its snapshots, and how long it keeps them.
BACKUP_DIR=/srv/md-service/backups
BACKUP_RETENTION_DAYS=14

# Structured JSON request logs and public per-owner rate limiting.
# Set RATE_LIMIT_REQUESTS_PER_MINUTE=0 to disable the limiter.
LOG_LEVEL=INFO
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# Worker identity and GPU selection.
WORKER_ID=gpu-0
API_URL=http://api:8000
CUDA_VISIBLE_DEVICES=0

# Worker loop defaults (optional).
WORKER_HOSTNAME=
WORKER_GPU_NAME=
WORKER_GPU_UUID=
SIMULATE_PATH=/app/simulate.py
SIMULATE_CWD=/app
WORKER_POLL_SECONDS=2
WORKER_HEARTBEAT_SECONDS=10
WORKER_PROGRESS_POLL_SECONDS=2
WORKER_PROGRESS_SEND_SECONDS=30
WORKER_CANCEL_GRACE_SECONDS=30
WORKER_CANCEL_TERM_SECONDS=10
WORKER_REQUEST_TIMEOUT_SECONDS=30
WORKER_MAX_ARTIFACTS=2000

# Lease lifecycle (defaults shown).  The API reaps expired leases in a
# background thread.
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
REAPER_INTERVAL_SECONDS=10

# Admission and operations (defaults shown).
MAX_QUEUED_JOBS_PER_OWNER=5
# Atom budget for a single uploaded structure.  A byte limit does not bound
# the GPU time, because the simulation cost grows with the atom count.
MAX_UPLOAD_ATOMS=250000
MIN_FREE_DISK_BYTES=536870912
RETENTION_DAYS=0
ORPHAN_WORKSPACE_HOURS=24

# Server-sent events and log tailing.
EVENT_STREAM_POLL_SECONDS=1
EVENT_STREAM_HEARTBEAT_SECONDS=15
LOG_TAIL_MAX_BYTES=262144
LOG_TAIL_DEFAULT_LINES=200

# Host bind-mount roots used by Compose (Phase 6).
HOST_DB_DIR=/srv/md-service/db
HOST_DATA_DIR=/srv/md-service/data

# System preparation: path to the packmol-memgen executable used by membrane
# embedding.  Set to the packmol-memgen wrapper script path (e.g.
# /opt/worker/packmol-memgen-wrapper in the prep-worker container, or
# /path/to/service/worker/packmol-memgen-wrapper locally).  Leave empty to
# disable prep endpoints.
#
# Install via pip:  pip install packmol packmol-memgen biopython pandas
#                   matplotlib numba scipy pdb2pqr gemmi
#
# The packmol binary must also be on PATH (pip-installed packmol provides it).
PACKMOL_PATH=/opt/worker/packmol-memgen-wrapper

# Prep worker settings (used by the prep-worker service).
PREP_POLL_SECONDS=2
PREP_HEARTBEAT_SECONDS=10
PREP_PROGRESS_POLL_SECONDS=2
PREP_PROGRESS_SEND_SECONDS=30
PREP_CANCEL_GRACE_SECONDS=30
PREP_CANCEL_TERM_SECONDS=10
PREP_REQUEST_TIMEOUT_SECONDS=30
